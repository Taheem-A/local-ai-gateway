LM_BASE_URL=http://127.0.0.1:1234
LM_API_TOKEN=replace-me
GATEWAY_API_KEY=replace-me

MODEL_FAST=google/gemma-4-12b-qat
MODEL_BALANCED=google/gemma-4-12b-qat
MODEL_DEFAULT=openai/gpt-oss-20b
MODEL_DEEP=openai/gpt-oss-20b

# `balanced` intentionally preserves the historical Gemma benchmark mapping.
# New application code should normally use `default` or `deep`.
REASONING_FAST=
REASONING_BALANCED=
# GPT-OSS low won the everyday latency/quality trade-off in the frozen
# September 2026 reasoning benchmark; high is reserved for hard tasks.
REASONING_DEFAULT=low
REASONING_DEEP=high

DEFAULT_CONTEXT_LENGTH=16384
DEFAULT_MAX_OUTPUT_TOKENS=2048
STRUCTURED_MAX_ATTEMPTS=2
LM_TIMEOUT_SECONDS=300
METRICS_DB_PATH=data/gateway.db
LOG_PROMPT_CONTENT=false
