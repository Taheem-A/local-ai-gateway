LM_BASE_URL=http://127.0.0.1:1234
LM_API_TOKEN=replace-me
GATEWAY_API_KEY=replace-me

MODEL_FAST=google/gemma-4-12b-qat
MODEL_DEFAULT=openai/gpt-oss-20b
MODEL_DEEP=openai/gpt-oss-20b

# The benchmark established GPT-OSS medium as the known-good configuration.
# Keep deep at medium until low/medium/high are benchmarked separately.
REASONING_FAST=
REASONING_DEFAULT=medium
REASONING_DEEP=medium

DEFAULT_CONTEXT_LENGTH=16384
DEFAULT_MAX_OUTPUT_TOKENS=2048
STRUCTURED_MAX_ATTEMPTS=2
LM_TIMEOUT_SECONDS=300
METRICS_DB_PATH=data/gateway.db
LOG_PROMPT_CONTENT=false
