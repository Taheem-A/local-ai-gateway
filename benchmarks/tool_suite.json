    {
      "id": "tool-write-risk",
      "messages": [
        {"role": "user", "content": "Create a reminder with the text 'Submit lab' for 2026-09-18 at 18:00."}
      ],
      "tools": [
        {
          "name": "create_reminder",
          "description": "Create a reminder at a local date and 24-hour local time.",
          "risk": "write",
          "parameters": {
            "type": "object",
            "properties": {
              "text": {"type": "string"},
              "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
              "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"}
            },
            "required": ["text", "date", "time"],
            "additionalProperties": false
          }
        },
        {
          "name": "list_reminders",
          "description": "List existing reminders without modifying them.",
          "risk": "read",
          "parameters": {"type": "object", "properties": {}, "additionalProperties": false}
        }
      ],
      "tool_choice": "auto",
      "expect": {
        "status": "tool_calls",
        "calls": [
          {
            "name": "create_reminder",
            "risk": "write",
            "arguments": {"text": "Submit lab", "date": "2026-09-18", "time": "18:00"}
          }
        ]
      }
    },
    {
      "id": "tool-enum-argument",
