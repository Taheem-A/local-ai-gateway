{
  "version": 1,
  "cases": [
    {
      "id": "tool-weather",
      "messages": [
        {"role": "user", "content": "What is the current temperature in Toronto? Use the appropriate tool rather than guessing."}
      ],
      "tools": [
        {
          "name": "get_weather",
          "description": "Get current weather observations for one city.",
          "risk": "read",
          "parameters": {
            "type": "object",
            "properties": {"city": {"type": "string"}},
            "required": ["city"],
            "additionalProperties": false
          }
        },
        {
          "name": "lookup_course_room",
          "description": "Look up the room for a university course section.",
          "risk": "read",
          "parameters": {
            "type": "object",
            "properties": {
              "course": {"type": "string"},
              "section": {"type": "string"}
            },
            "required": ["course", "section"],
            "additionalProperties": false
          }
        }
      ],
      "tool_choice": "auto",
      "expect": {
        "status": "tool_calls",
        "calls": [
          {"name": "get_weather", "risk": "read", "arguments": {"city": "Toronto"}}
        ]
      }
    },
    {
      "id": "tool-course-room",
      "messages": [
        {"role": "user", "content": "Find the room for CIV100 section L0101. Use a tool."}
      ],
      "tools": [
        {
          "name": "get_weather",
          "description": "Get current weather observations for one city.",
          "risk": "read",
          "parameters": {
            "type": "object",
            "properties": {"city": {"type": "string"}},
            "required": ["city"],
            "additionalProperties": false
          }
        },
        {
          "name": "lookup_course_room",
          "description": "Look up the room for a university course section.",
          "risk": "read",
          "parameters": {
            "type": "object",
            "properties": {
              "course": {"type": "string"},
              "section": {"type": "string"}
            },
            "required": ["course", "section"],
            "additionalProperties": false
          }
        },
        {
          "name": "calculate",
